{
  "expo": {
    "name": "BinRo",
    "slug": "binro",
    "version": "1.0.23",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios"
    ],
    "splash": {
      "image": "./assets/images/Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qrguard.app"
    },
    "android": {
      "package": "com.qrguard.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17",
        "backgroundImage": "./assets/images/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "react-native-iap",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BinRo to use your camera to scan QR codes"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/android-network-security.js",
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
