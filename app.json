{
  "expo": {
    "name": "BinRo",
    "slug": "binro",
    "version": "1.0.31",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios"
    ],
    "splash": {
      "image": "./assets/images/Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.binro.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "BinRo uses your camera to scan QR codes.",
        "NSPhotoLibraryUsageDescription": "BinRo accesses your photo library to scan QR codes from saved images and to let you upload a profile photo.",
        "NSPhotoLibraryAddUsageDescription": "BinRo saves generated QR codes to your photo library.",
        "NSMicrophoneUsageDescription": "BinRo may access the microphone when scanning QR codes via video mode.",
        "NSLocationWhenInUseUsageDescription": "BinRo uses your location to verify nearby merchant QR codes and improve fraud detection accuracy.",
        "NSFaceIDUsageDescription": "BinRo uses Face ID to securely authenticate you without a password."
      }
    },
    "android": {
      "package": "com.qrguard.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17",
        "backgroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BinRo to use your camera to scan QR codes"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "packagingOptions": {
              "pickFirst": [
                "lib/armeabi-v7a/libc++_shared.so",
                "lib/arm64-v8a/libc++_shared.so",
                "lib/x86/libc++_shared.so",
                "lib/x86_64/libc++_shared.so"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static",
            "flipper": false
          }
        }
      ],
      "./plugins/android-network-security.js",
      "./plugins/android-device-compat.js",
      "./plugins/android-r8.js",
      "./plugins/android-font-filter.js",
      "./plugins/android-size-optimize.js",
      "./plugins/android-abi-filter.js",
      "./plugins/ios-modular-headers.js",
      "./plugins/ios-size-optimize.js",
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "assetBundlePatterns": [
      "assets/**",
      "node_modules/@expo-google-fonts/inter/*.ttf"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00706bfd-954e-46ad-ab74-8b1f1933dc39"
      }
    }
  }
}
