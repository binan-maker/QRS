{
  "expo": {
    "name": "BinRo",
    "slug": "binro",
    "version": "1.0.31",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios"
    ],
    "splash": {
      "image": "./assets/images/Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E17"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qrguard.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qrguard.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17",
        "backgroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "react-native-iap",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BinRo to use your camera to scan QR codes"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "packagingOptions": {
              "pickFirst": [
                "lib/armeabi-v7a/libc++_shared.so",
                "lib/arm64-v8a/libc++_shared.so",
                "lib/x86/libc++_shared.so",
                "lib/x86_64/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "./plugins/android-network-security.js",
      "./plugins/android-device-compat.js",
      "./plugins/android-r8.js",
      "./plugins/android-font-filter.js",
      "./plugins/android-size-optimize.js",
      "./plugins/android-abi-filter.js",
      "expo-localization",
      "expo-secure-store",
      "./plugins/ios-modular-headers.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "244a74a6-7761-4118-924d-3b534103f8d5"
      }
    }
  }
}
