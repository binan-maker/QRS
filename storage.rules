rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ────────────────────────────────────────────────────────────────
    // Only the authenticated owner of the subfolder may write.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Writes that create or modify account data require a verified email address.
    // The claim is embedded in the Firebase-issued JWT and cannot be spoofed.
    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    // ── Profile photos ─────────────────────────────────────────────────────────
    // Path produced by storage-service.ts:
    //   profile-photos/{userId}/{timestamp_random}.{ext}
    match /profile-photos/{userId}/{fileName} {
      allow read:  if true;
      allow write: if isVerifiedOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024;   // 5 MB cap
    }

    // ── QR code logos ──────────────────────────────────────────────────────────
    // Path: qr-logos/{userId}/{timestamp_random}.{ext}
    match /qr-logos/{userId}/{fileName} {
      allow read:  if true;
      allow write: if isVerifiedOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024;   // 5 MB cap
    }

    // ── Verification documents ─────────────────────────────────────────────────
    // Path: verification-docs/{userId}/{fileName}
    match /verification-docs/{userId}/{fileName} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if isVerifiedOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024;  // 10 MB cap
    }

    // ── Public assets (managed via Firebase Console / CLI only) ───────────────
    match /public/{fileName} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Default: deny everything else ─────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
