{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./shared/*"],
      "@services/*": ["./services/*"],
      "@binro/core": ["./packages/core/src/index.ts"],
      "@binro/core/*": ["./packages/core/src/*"],
      "@binro/db": ["./packages/db/src/index.ts"],
      "@binro/db/*": ["./packages/db/src/*"],
      "@binro/config": ["./packages/config/src/index.ts"],
      "@binro/config/*": ["./packages/config/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules/expo-file-system/src/legacy",
    "packages/*/dist",
    "apps/api/dist"
  ]
}
