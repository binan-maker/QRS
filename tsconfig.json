{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "baseUrl": "../..",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["*"],
      "@shared/*": ["shared/*"],
      "@services/*": ["services/*"],
      "@binro/core": ["packages/core/src/index.ts"],
      "@binro/core/*": ["packages/core/src/*"],
      "@binro/db": ["packages/db/src/index.ts"],
      "@binro/config": ["packages/config/src/index.ts"],
      "@binro/config/*": ["packages/config/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
